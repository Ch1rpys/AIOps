# 复制为 .env，再填写；空值不会伪装成已配置。
ADMIN_TOKEN=
DEMO_MYSQL_ROOT_PASSWORD=
DEMO_MYSQL_PASSWORD=
MYSQL_PORT=13306
REDIS_PORT=16379
HOLMES_URL=http://127.0.0.1:5050
HOLMES_API_KEY=
HOLMES_MODEL=
OPENAI_API_KEY=
# 独立规划模型的 OpenAI-compatible /v1 地址；与 Holmes 诊断分别调用。
PLANNER_URL=
PLANNER_API_KEY=
PLANNER_MODEL=
# DeepSeek 使用 json_object；输出仍由服务端按原 Schema 严格验证。
HOLMES_JSON_MODE=json_schema
PLANNER_JSON_MODE=json_schema
# 视觉模型（通义千问多模态）：模型 ID 以账号实际可用的为准，不要写死示例值。
# 留空时视觉能力在健康检查里显示 UNKNOWN，不做降级伪装。
VISION_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=
DEEPSEEK_API=
# 影子世界：独立项目 aiops-twin、独立端口与配置目录。见 docs/影子世界与故障编译器计划.md §5.1。
TWIN_MYSQL_PORT=23306
TWIN_REDIS_PORT=26379
TWIN_APP_URL=http://127.0.0.1:28000
TWIN_NGINX_URL=http://127.0.0.1:28080
# 仅开发允许重冻 holdout。演示默认关闭。
ALLOW_HOLDOUT_FREEZE=false
# 把 R 臂搜索结果喂给规划模型会污染对照，默认关闭。
R_ARM_PLANNER_CONTEXT=false
PROBE_TIMEOUT=3
MODEL_TIMEOUT=90
# 盲诊评测预算（见 docs/落地执行计划.md §9.4）：预算是上限，不是配额。
# 单次调用超时 × 最大调用次数必须不大于总预算，否则「超限终止」无法实现。
EVALUATION_MODEL_TIMEOUT=15
EVALUATION_BUDGET_SECONDS=45
EVALUATION_MAX_MODEL_CALLS=3
EVALUATION_UNSEEN_MODEL_TIMEOUT=180
EVALUATION_UNSEEN_BUDGET_SECONDS=300
EVALUATION_MAX_EXTRA_COLLECTS=2
VERIFICATION_ATTEMPTS=5
VERIFICATION_INTERVAL=3
# 连续健康窗口：默认关闭，关闭时判定与现状逐字一致。
VERIFICATION_WINDOW_ENABLED=false
VERIFICATION_WINDOW_SAMPLES=5
VERIFICATION_REQUIRED_PASSES=3
VERIFICATION_WINDOW_SECONDS=30
FAULT_CONFIRMATION_ATTEMPTS=3
FAULT_CONFIRMATION_INTERVAL=2
# 受限主动补采（§6.2）：模型只能从已注册的检查 ID 里选，轮次与耗时都封顶。
SUPPLEMENT_MAX_ROUNDS=2
SUPPLEMENT_MAX_CHECKS=2
SUPPLEMENT_BUDGET_SECONDS=45
LANGGRAPH_STRICT_MSGPACK=true
