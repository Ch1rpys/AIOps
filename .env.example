# 复制为 .env，再填写；空值不会伪装成已配置。
ADMIN_TOKEN=
DEMO_MYSQL_ROOT_PASSWORD=
DEMO_MYSQL_PASSWORD=
MYSQL_PORT=13306
REDIS_PORT=16379
HOLMES_URL=http://127.0.0.1:5050
HOLMES_API_KEY=
HOLMES_MODEL=
OPENAI_API_KEY=
# 独立规划模型的 OpenAI-compatible /v1 地址；与 Holmes 诊断分别调用。
PLANNER_URL=
PLANNER_API_KEY=
PLANNER_MODEL=
# DeepSeek 使用 json_object；输出仍由服务端按原 Schema 严格验证。
HOLMES_JSON_MODE=json_schema
PLANNER_JSON_MODE=json_schema
DEEPSEEK_API=
PROBE_TIMEOUT=3
MODEL_TIMEOUT=90
VERIFICATION_ATTEMPTS=5
VERIFICATION_INTERVAL=3
FAULT_CONFIRMATION_ATTEMPTS=3
FAULT_CONFIRMATION_INTERVAL=2
LANGGRAPH_STRICT_MSGPACK=true
