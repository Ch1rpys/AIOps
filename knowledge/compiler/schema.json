{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiops.local/compiler/recipe.schema.json",
  "title": "Fault compiler recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "primitives"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^rec_[0-9a-f]{12}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "primitives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4
    },
    "recoverable": { "type": "boolean" },
    "negative": { "type": "boolean" },
    "poison": { "type": "boolean" },
    "canonical_scene": {
      "type": ["string", "null"],
      "enum": [
        "MYSQL_DOWN",
        "REDIS_DOWN",
        "NGINX_502",
        "NGINX_UPSTREAM",
        "APP_HTTP_500",
        "DUAL_MYSQL_REDIS",
        null
      ]
    },
    "preferred_actions": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 8
    }
  }
}
